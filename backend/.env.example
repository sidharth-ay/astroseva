# AstroSeva backend environment.
#
# Only JWT_SECRET is required -- the service refuses to start without it, which
# is the intended fail-fast. Everything else has a working default, so a fresh
# clone runs with nothing but JWT_SECRET set.
#
# Copy to .env and fill in what you need:
#   cp .env.example .env

# --- required ---------------------------------------------------------------

# Secret used to sign access tokens. Long random string. Rotating it invalidates
# every existing session.
JWT_SECRET=change-me-to-a-long-random-string

# --- database ---------------------------------------------------------------

# Defaults to a local SQLite file, which is fine for development. Production
# should point at PostgreSQL.
DATABASE_URL=sqlite:///./astroseva.db
# DATABASE_URL=postgresql://astroseva:password@localhost:5432/astroseva

# --- cache ------------------------------------------------------------------

# Defaults to a local Redis. Without it the app falls back to a disk-backed
# cache, so this is optional for development.
REDIS_URL=redis://localhost:6379/0

# --- AI layer ---------------------------------------------------------------

# Optional. Without a key the app serves its own deterministic fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# --- auth -------------------------------------------------------------------

# Access token lifetime in minutes. Refresh tokens last 30 days and rotate on
# use, so this only controls how often a client must refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_ALGORITHM=HS256

# --- CORS -------------------------------------------------------------------

# Comma-separated list of origins allowed to read responses. Defaults to
# localhost:3000/3001. Must include the frontend origin in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CORS_ALLOW_CREDENTIALS=false

# --- rate limiting ----------------------------------------------------------

# /health is polled by uptime checks and CI, so it carries its own ceiling.
RATELIMIT_HEALTH=1000/minute

# --- email ------------------------------------------------------------------

# Off by default: outgoing mail is logged instead of sent, so password reset
# and verification are testable without SMTP credentials.
EMAIL_ENABLED=0
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=norecast@astroseva.com
SMTP_TLS=1

# --- background jobs --------------------------------------------------------

# How often the job sweeper runs, and how many pending jobs one pass handles.
JOB_SWEEP_INTERVAL_SECONDS=60
JOB_SWEEP_BATCH=25

# --- storage ----------------------------------------------------------------

# Where marketplace uploads are written. Uploads are validated against their
# declared content type and are never served from a public path.
# STORAGE_ROOT=/absolute/path/to/storage
MAX_UPLOAD_BYTES=10485760

# --- misc -------------------------------------------------------------------

# Set to 1 to enable the interactive API docs at /docs.
ENABLE_DOCS=false
APP_NAME=AstroSeva
APP_VERSION=1.0.0
DEBUG=false

# Trusted proxies for X-Forwarded-For. Behind a CDN on another network, set
# this to that network. Never set it to "*" -- then any client can forge the
# header and mint itself a fresh rate-limit bucket.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1